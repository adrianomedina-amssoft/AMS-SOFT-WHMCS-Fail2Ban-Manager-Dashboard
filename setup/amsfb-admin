def matches(path, lines, peers=False):
    from fail2ban.client.fail2banregex import Fail2banRegex, get_opt_parser
    opts, _ = get_opt_parser().parse_args(['--print-no-missed', '--print-no-ignored', '-r'])
    runner = Fail2banRegex(opts)
    with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
        if not runner.start(['\n'.join(lines), str(path)]):
            raise FilterValidationError('filter_syntax', 'Invalid fail2ban filter')
    if peers:
        return [str(item[1]) for regex in runner._failregex for item in regex.getIPList()]
    return runner._line_stats.matched


def validate_filter(text, evidence):
    try: cfg = parse(text)
    except configparser.Error as exc:
        raise FilterValidationError('filter_syntax','Invalid filter definition') from exc
    if cfg.defaults() or cfg.sections() != ['Definition']:
        raise FilterValidationError('filter_definition','Only Definition is allowed')
    if set(cfg['Definition']) - {'failregex', 'ignoreregex'}:
        raise FilterValidationError('filter_definition','Filter includes/options are forbidden')
    patterns = cfg.get('Definition', 'failregex').splitlines()
    if not patterns or any(p.count('<HOST>') != 1 for p in patterns if p.strip()):
        raise FilterValidationError('filter_host', 'Each expression needs exactly one HOST')
    if any(p.strip().startswith((r'^.*', r'^.+')) for p in patterns if p.strip()):
        raise FilterValidationError('filter_peer', 'Arbitrary prefix before peer is forbidden')
    with tempfile.TemporaryDirectory(prefix='amsfb-validate-') as d:
        p = Path(d) / 'candidate.conf'
        p.write_text(text)
        if matches(p, legitimate_lines()):
            raise FilterValidationError('filter_legitimate', 'Filter matches legitimate traffic')
        positives = [x for x in evidence if isinstance(x, str) and len(x) < 65536]
        if not positives or not matches(p, positives):
            raise FilterValidationError('filter_positive', 'Filter does not match source evidence')
        matched=[line for line in positives if matches(p,[line])]
        if any(non_offensive_line(line) for line in matched):
            raise FilterValidationError('filter_signal','Operational status or user agent signals do not authorize blocking')
        negatives = []
        for line in positives:
            # Counterfactual requests retain status/agent/peer but remove the
            # suspect target. UA/404 identity alone must not authorize a ban.
            if (not re.search(r'\(\)\s*\{\s*:;|\$\{jndi:', line, re.I)
                    and re.search(r'"(GET|POST|HEAD|PUT|DELETE|OPTIONS|PATCH) [^ ]+ HTTP/',line)):
                for target in ('/','/clientarea.php','/robots.txt'):
                    negatives.append(re.sub(r'"(GET|POST|HEAD|PUT|DELETE|OPTIONS|PATCH) [^ ]+ (HTTP/[^"]+)"',
                                            r'"\1 '+target+r' \2"', line))
        # A root request with scanner UA/status is itself a counterfactual
        # ordinary target. Do not drop it just because the model cited it.
        if negatives and matches(p, negatives):
            raise FilterValidationError('filter_identity', 'Filter depends only on peer, status or user agent')
        # Every expression must stand on its own; one valid OR branch must not
        # conceal an unproven second branch. Captured IP must be the real peer.
        for pattern in patterns:
            if not pattern.strip():
                continue
            p.write_text('[Definition]\nfailregex = ' + pattern.strip() + '\nignoreregex =\n')
            branch_matches=[line for line in positives if matches(p,[line])]
            if any(non_offensive_line(line) for line in branch_matches):
                raise FilterValidationError('filter_signal','Each branch requires offensive evidence')
            proved = False
            for line in positives:
                peer = source_peer(line)
                captured = matches(p, [line], peers=True)
                if captured:
                    try:
                        correct = peer is not None and all(str(ipaddress.ip_address(ip)) == peer for ip in captured)
                    except ValueError:
                        correct = False
                    if not correct:
                        raise FilterValidationError('filter_peer', 'Filter captures a different peer')
                    proved = True
            if not proved:
                raise FilterValidationError('filter_branch', 'Each regex needs source evidence')
            # Untrusted trailing fields cannot choose the peer.
            for line in positives:
                if re.search(r'^\S+\s+-\s+', line):
                    variants=(line + ' 203.0.113.77', re.sub(r'"([^"]*)"$', r'"\1 203.0.113.77"', line))
                else:
                    header=re.search(r'^(?:\[[^\]\r\n]*\]\s*)*?\[client [^\]]+\]\s*(.*)$',line)
                    variants=(line+' [client 203.0.113.77:4444] '+header[1],) if header else ()
                for variant in variants:
                    captured = matches(p, [variant], peers=True)
                    try:
                        exact = all(str(ipaddress.ip_address(address)) == source_peer(variant) for address in captured)
                    except ValueError:
                        exact = False
                    if not exact:
                        raise FilterValidationError('filter_peer', 'Forged field changes captured peer')


    return {'matched_sha256':[hashlib.sha256(line.encode()).hexdigest() for line in matched]}


