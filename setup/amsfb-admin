def sql_query_pattern():
    # Byte-for-byte parity with SqlInjection::queryPattern().
    s=r'(?:[+ ]|%20|%2520){1,8}';o=r'(?:[+ ]|%20|%2520){0,8}'
    q=r'(?:[\x22\x27]|%22|%27|%2522|%2527)'
    lp=r'(?:\(|%28|%2528)';rp=r'(?:\)|%29|%2529)'
    comma=r'(?:,|%2c|%252c)';eq=r'(?:=|%3d|%253d)';comment=r'(?:-|%2d|%252d){2}'
    value=r'(?:null|[0-9]{1,12}|'+q+r'[a-z0-9_]{1,128}'+q+r')'
    union='union'+s+'(?:all'+s+')?select'+s+value+'(?:'+o+comma+o+value+'){0,7}'+o+comment
    extract='(?:and'+s+')?extractvalue'+o+lp+r'[0-9]{1,12}'+comma+o+'concat'+o+lp+r'0x[0-9a-f]{1,16}'+comma+r'[^"&#\r\n]{1,256}select'+s+r'[^"&#\r\n]{1,512}'+comment
    order=s+'order'+s+'by'+s+r'[0-9]{1,6}'+o+comment
    boolean=q+rp+s+'and'+s+lp+q+r'[a-z]{3,32}'+q+eq+q+r'[a-z]{3,32}'+q+q
    return '(?:'+union+'|'+extract+'|'+order+'|'+boolean+')'


def sql_target(target):
    return (isinstance(target,str) and len(target.encode('utf-8',errors='surrogatepass'))<=8192
            and target.startswith('/') and not re.search(r'[\x00-\x1f\x7f]',target)
            and '?' in target and re.search(sql_query_pattern(),target.split('?',1)[1],re.I) is not None)


def sql_filter():
    # Only the two audited WHMCS root scripts, no UA/referrer/path authority.
    target=r'/(?:cart|index)\.php\?(?=[^ "\r\n]{1,8192} HTTP/\d(?:\.\d)?" [1-5]\d\d (?:\d+|-)(?: |$))[^ "\r\n]*?(?i:'+sql_query_pattern()+r')[^ "\r\n]*'
    expression=r'^<HOST> - \S+ \[\s*\] "[A-Z]{3,12} '+target+r' HTTP/\d(?:\.\d)?" [1-5]\d\d (?:\d+|-)(?: |$)'
    return '[Definition]\nfailregex = '+expression.replace('%','%%')+'\nignoreregex =\n'


def php_cgi_target_pattern():
    # Keep in parity with PhpCgiProbe::pattern(); no arbitrary caller regex.
    flag = r'(?:-|%2d|%252d|%ad|%25ad|%c2%ad|%25c2%25ad|\xAD|\xC2\xAD)d'
    separator = r'(?:\+|%20|%2520| ){1,8}'
    equals = r'(?:=|%3d|%253d)'
    colon = r'(?::|%3a|%253a)'
    slash = r'(?:/|%2f|%252f)'
    allow = flag + separator + 'allow_url_include' + equals + '(?:1|on|true)'
    prepend = flag + separator + 'auto_prepend_file' + equals + 'php' + colon + slash + slash + 'input'
    return r'/[^ "?#\r\n]{0,8190}\?(?:' + allow + separator + prepend + '|' + prepend + separator + allow + ')'


def php_cgi_target(target):
    return (isinstance(target, str) and len(target.encode('utf-8', errors='surrogatepass')) <= 8192
            and not re.search(r'[\x00-\x1f\x7f]', target)
            and re.fullmatch(php_cgi_target_pattern(), target, re.I) is not None)


def sensitive_filter(groups, enabled=True):
    if not isinstance(groups, list) or not groups or any(g not in PROBE_GROUPS for g in groups):
        raise ValueError('Unknown/empty sensitive group selection')
    dot = TRAVERSAL_DOT
    slash = TRAVERSAL_SLASH
    # Bare repository metadata directories are private too. Do not let the
    # common optional path-info suffix turn this branch into .git/anything.
    bare = lambda name: name + r'(?!(?:' + slash + r')[^ "?])'
    backup = r'(?:'+dot+r'(?:bak|old|save|swp|orig)|~)'
    patterns = {
        'env': dot+r'env(?!(?:'+dot+r'(?:example|sample|dist))(?:(?:'+slash+r')|%20|[? "]|$))(?:'+dot+r'[A-Za-z0-9_-]+)*',
        'git': r'(?:'+bare(dot+r'git')+r'|'+dot+r'git'+slash+r'(?:config|HEAD|index|packed-refs|description|info'+slash+r'refs|logs'+slash+r'HEAD))',
        'svn': r'(?:'+bare(dot+r'svn')+r'|'+dot+r'svn'+slash+r'(?:wc'+dot+r'db|entries))',
        'wpconfig': r'wp-config'+dot+r'php(?:'+backup+r')?',
        'credentials': r'(?:(?:'+dot+r'aws'+slash+r'(?:credentials|config)|'+dot+r'docker'+slash+r'config'+dot+r'json|'+dot+r'ssh'+slash+r'(?:id_rsa|id_ed25519|config|authorized_keys|known_hosts)|'+dot+r'(?:npmrc|netrc|pypirc|boto|git-credentials)|'+dot+r'kube'+slash+r'config|'+dot+r'claude'+slash+dot+r'credentials'+dot+r'json)(?:'+backup+r')?|(?:configuration|config)'+dot+r'php'+backup+r')',
        'wordpress': r'(?:xmlrpc'+dot+r'php|wp-login'+dot+r'php|wp-admin|wp-includes'+slash+r'wlwmanifest'+dot+r'xml)',
        'cms': r'(?:administrator'+slash+r'manifests'+slash+r'files'+slash+r'joomla'+dot+r'xml|magento_version|core'+slash+r'install'+dot+r'php)',
        'traversal': TRAVERSAL_DOT+r'{2}'+TRAVERSAL_SLASH+r'[^ "?]*',
        'phpunit': r'(?:vendor'+slash+r')?phpunit(?:'+slash+r'phpunit)?(?:'+slash+r'src)?'+slash+r'Util'+slash+r'PHP'+slash+r'(?:Template'+slash+r')?eval-stdin'+dot+r'php(?:'+dot+r'dev)?',
        'debug': r'(?:phpinfo(?:'+dot+r'php)?|info'+dot+r'php|_profiler'+slash+r'phpinfo|storage'+slash+r'logs'+slash+r'laravel'+dot+r'log|_ignition'+slash+r'execute-solution)',
        'db_admin': r'(?:phpmyadmin(?:[-_]?[0-9][a-z0-9._-]{0,32})?|php-myadmin|pma|myadmin)',
    }
    # Only the structured request target; no arbitrary regex from a caller.
    path_groups=[g for g in PROBE_GROUPS if g in groups and g not in ('query_traversal','exchange_probe','gpon_probe','webshell_probe','php_cgi_probe','session_lfi_probe') and g not in APPLICATION_TRAPS]
    targets=[]
    if path_groups:
        targets.append(r'/(?:[^ "?]*'+slash+r')?(?i:'+'|'.join(patterns[g] for g in path_groups)+r')(?:'+slash+r'[^ "?]*)?(?:%20){0,2}(?:\?[^ "\r\n]*)?')
    if 'query_traversal' in groups:
        # Closed LFI/traversal signatures, not arbitrary parent segments.
        separator=TRAVERSAL_SLASH
        parents=r'(?:'+TRAVERSAL_DOT+r'{2}'+separator+r'{1,16}){2,16}'
        sink=r'(?i:etc'+separator+r'(?:passwd|shadow)|proc'+separator+r'self'+separator+r'environ|dev'+separator+r'cmdb'+separator+r'sslvpn_websession|windows'+separator+r'win\.ini)'
        query=r'/[^ "?\r\n]*\?(?:[^ "&#\r\n]{0,512}&){0,32}(?i:file|path|page|template|lang|language|include|document|download|resource|url)='+separator+r'{0,16}'+parents+sink+r'(?:&[^ "\r\n]*)?'
        targets.append(query)
    if 'exchange_probe' in groups:
        # Exact root targets only, not generic OWA/Autodiscover or any JS file.
        # This branch intentionally bypasses the optional directory/path-info
        # prefix/suffix of the other groups. UA/referrer never select a target.
        owa=slash+r'owa'+slash+r'auth'+slash+r'x'+dot+r'js(?:\?[^ "\r\n]*)?'
        discovery=slash+r'autodiscover'+slash+r'autodiscover'+dot+r'json\?@zdi'+slash+r'Powershell'
        targets.append(r'(?i:'+owa+r'|'+discovery+r')')
    if 'gpon_probe' in groups:
        # Audited router probe on this non-router host. Exact root/query and
        # POST only; never infer an exploit from a generic GPON path or 403.
        targets.append(r'(?<="POST )(?i:/GponForm/diag_Form\?style/)')
    if 'webshell_probe' in groups:
        # Audited exact endpoints on a host without these WordPress/plugin routes.
        # No arbitrary PHP names, directory prefixes or path-info suffixes.
        root=slash+r'(?:wp-filemanager1'+dot+r'php|wp-security'+dot+r'php)'
        plugin=slash+r'wp-content'+slash+r'plugins'+slash+r'hellopress'+slash+r'wp_filemanager'+dot+r'php'
        targets.append(r'(?i:(?:'+root+r'|'+plugin+r')(?:\?[^ "\r\n]*)?)')
    if 'php_cgi_probe' in groups:
        targets.append(r'(?i:'+php_cgi_target_pattern()+')')
    if 'session_lfi_probe' in groups:
        # Audited absent endpoint; exact query and bounded private session name.
        # No generic PHP/query authority, path-info or arbitrary sink.
        targets.append(r'/vuln\.php\?page='+slash+'tmp'+slash+'sessions'+slash+r'sess_[A-Za-z0-9_-]{1,128}')
    # Literal root targets for absent applications only; no generic path groups,
    # normalization, case folding, suffix or UA/referrer authority.
    for group, paths in APPLICATION_TRAPS.items():
        if group in groups:
            targets.append(r'(?:'+'|'.join(re.escape(path) for path in paths)+r')(?:\?[^ "\r\n]*)?')
    target=r'(?:'+'|'.join(targets)+r')'
    envelope=r'(?=[A-Z]{3,12} [^ "\r\n]{1,8192} HTTP/\d(?:\.\d)?" [1-5]\d\d (?:\d+|-)(?: |$))'
    regex=r'^<HOST> - \S+ \[\s*\] "'+envelope+r'[A-Z]{3,12} '+target+r' HTTP/\d(?:\.\d)?" [1-5]\d\d (?:\d+|-)(?: |$)'
    if not enabled:regex=r'^(?!)<HOST>$'
    return '[Definition]\nfailregex = '+regex.replace('%','%%')+'\nignoreregex =\n'


def traversal_filter(enabled=True):
    path=r'/(?:[^() "\r\n]*'+TRAVERSAL_SLASH+r')?'+TRAVERSAL_DOT+r'{2}'+TRAVERSAL_SLASH+r'[^() "\r\n]*'
    envelope=r'(?=[^() "\r\n]{1,8192}\)(?:, referer: [^\r\n]{0,8192})?\s*$)'
    regex=r'^\[\s*\]\s+\[[^\]\r\n]+\]\s+(?:\[pid [^\]\r\n]+\]\s+)?\[client <HOST>:\d+\]\s+AH10244: invalid URI path \('+envelope+path+r'\)(?:, referer: [^\r\n]{0,8192})?\s*$'
    if not enabled:regex=r'^(?!)<HOST>$'
    return '[Definition]\nfailregex = '+regex.replace('%','%%')+'\nignoreregex =\n'


def query_probe_route(line):
    """Behavioral lead only. PHP enforces individual validated repetition."""
    if len(line) > 65536:
        return None
    m = re.fullmatch(r'\S+ - \S+ \[[^\]\r\n]+\] "(?:GET|HEAD) ([^ "\r\n]{1,8192}) HTTP/\d(?:\.\d)?" 5\d\d (?:\d+|-) "[^"\r\n]*" "[^"\r\n]*"', line)
    if not m or php_cgi_target(m[1]) or sql_target(m[1]) or '?' not in m[1]:
        return None
    def decode(value):
        for _ in range(2):
            value = unquote(value)
        return '' if re.search(r'[\x00-\x1f\x7f]', value) else value
    path, query = m[1].split('?', 1)
    path = decode(path)
    if not re.fullmatch(r'/[A-Za-z0-9_./-]*', path):
        return None
    for pair in query.split('&'):
        if '=' not in pair:
            continue
        key, value = pair.split('=', 1)
        value = decode(value)
        if key and value.startswith('/') and value.endswith("'") and value.count("'") % 2:
            return path
    return None


def non_offensive_line(line):
    # Match only the actual request/header, never a URL in UA/referrer text.
    m=re.match(r'^\S+ - \S+ \[[^\]\r\n]*\] "[A-Z]{3,12} ([^ "\r\n]+) HTTP/[^"]+" (\d{3}) ',line)
    if m:
        target=m[1]
        if php_cgi_target(target) or sql_target(target):return False
        for _ in range(2):target=unquote(target)
        offensive=re.search(r'(?:^|/)\.(?:env(?:$|[./])|git/|svn/|ssh/|aws/|docker/|npmrc)|wp-config|xmlrpc\.php|wp-login\.php|wp-admin(?:/|$)|wp-includes/wlwmanifest\.xml|administrator/manifests/files/joomla\.xml|magento_version|core/install\.php|phpmyadmin|(?:^|/)\.\./|/etc/passwd',target.split('?',1)[0],re.I)
        offensive=offensive or sql_target(target) or re.search(r'\.\./|/etc/passwd|union\s+(?:all\s+)?select|sleep\s*\(|benchmark\s*\(|or\s+1\s*=\s*1|(?:;|\|)\s*(?:wget|curl|sh|bash)\b',target,re.I)
        if offensive:return False
        if query_probe_route(line) is not None:return False
        normal=set(normal_paths())
        return m[2]=='421' or (not re.search(r'[\x00-\x1f\x7f]',target) and target.split('?',1)[0] in normal)
    error=re.match(r'^(?:\[[^\]\r\n]*\]\s*)*?\[client [^\]\r\n]+\]\s+AH01630: client denied by server configuration: (/[^\r\n]+)',line)
    if error:
        target=error[1].split(', referer: ',1)[0]
        for _ in range(2):target=unquote(target)
        return not re.search(r'(?:^|/)\.(?:env(?:$|[./])|git/|svn/|ssh/|aws/|docker/|npmrc)|wp-(?:admin|content|includes|json)(?:/|$)|wp-(?:login|config|load)\.php|xmlrpc\.php|phpmyadmin|(?:^|/)\.\./|/etc/passwd',target,re.I)
    autoindex=re.match(r'^(?:\[[^\]\r\n]*\]\s*)*?\[client [^\]\r\n]+\]\s+AH01276:',line)
    if autoindex:
        directory=re.match(r'^ Cannot serve directory (/[^\r\n]*?): No matching DirectoryIndex \([^\r\n]*\) found, and server-generated directory index forbidden by Options directive(?:, referer: [^\r\n]*)?$',line[autoindex.end():])
        if directory:
            target=directory[1]
            for _ in range(2):target=unquote(target)
            target=re.sub(r'(?:^|/)\.env\.(?:example|sample|dist)(?=/|$)','/public-example',target,flags=re.I)
            if re.search(r'(?:^|/)\.(?:env(?:$|[./])|git(?:/|$)|svn/|ssh/|aws/|docker/|npmrc)|wp-(?:admin|content|includes|json)(?:/|$)|wp-(?:login|config|load)\.php|xmlrpc\.php|phpmyadmin|(?:^|/)\.\./|/etc/passwd',target,re.I):return False
        return True
    return bool(re.match(r'^(?:\[[^\]\r\n]*\]\s*)*?\[client [^\]\r\n]+\]\s+AH02032:',line))


def sync_sensitive_probes(payload):
    allowed={'enabled','groups','maxretry','findtime','bantime','whitelist'}
    if not isinstance(payload,dict) or set(payload)!=allowed:raise ValueError('Invalid sensitive policy fields')
    for key,lo,hi in [('enabled',0,1),('maxretry',1,10),('findtime',60,86400),('bantime',300,31536000)]:
        if type(payload[key]) is not int or not lo<=payload[key]<=hi:raise ValueError('Invalid sensitive '+key)
    if not isinstance(payload['whitelist'],list) or len(payload['whitelist'])>1000:raise ValueError('Invalid whitelist')
    required={str(ipaddress.ip_network(x,strict=False)) for x in payload['whitelist']}
    cfg=effective_config();jails=('apache-sensitive','apache-traversal','apache-scan')
    for jail in jails:
        if cfg.get(jail,{}).get('enabled','').lower() not in ('true','1','yes','on') or cfg[jail].get('filter')!=jail:
            raise ValueError('Existing active canonical jail required; never create/reactivate implicitly: '+jail)
        if any(j!=jail and c.get('filter','').split('[',1)[0]==jail and c.get('enabled','').lower() in ('true','1','yes','on') for j,c in cfg.items()):
            raise ValueError('Unexpected shared canonical filter')
    override=ROOT/'jail.d/zzzz-amsfb-sensitive.local'
    texts={'apache-sensitive':sensitive_filter(payload['groups'],bool(payload['enabled'])),
           'apache-traversal':traversal_filter(bool(payload['enabled']) and 'traversal' in payload['groups']),
           'apache-scan':'[Definition]\nfailregex = ^(?!)<HOST>$\nignoreregex =\n'}
    paths={j:ROOT/'filter.d'/(j+'.conf') for j in jails}
    if override.is_symlink() or any(p.is_symlink() or not p.is_file() for p in paths.values()):raise ValueError('Regular canonical files required')
    old={j:p.read_text() for j,p in paths.items()};previous=override.read_text() if override.exists() else None
    sources={'apache-sensitive':list(SENSITIVE_SOURCES),'apache-traversal':list(TRAVERSAL_SOURCES)}
    if any(not Path(p).is_file() for ps in sources.values() for p in ps):raise ValueError('Canonical source unavailable')
    before=tickets(list(jails),native=True);actions={j:FIREWALL['action_specs'](j,run) for j in jails}
    if any(not a for a in actions.values()):raise ValueError('Existing native actions required')
    body='# AMSFB deterministic request policy; preserve actions/tickets.\n'
    for jail,logs in sources.items():
        body+='['+jail+']\nenabled = true\nfilter = '+jail+'\nusedns = no\nlogpath = '+'\n          '.join(logs)+'\n'
        for key in ('maxretry','findtime','bantime'):body+=key+' = '+str(payload[key])+'\n'
    changed=any(old[j]!=texts[j] for j in jails) or previous!=body
    try:
        if changed:
            for j,p in paths.items():atomic_write(p,texts[j])
            atomic_write(override,body)
            run(['/usr/bin/fail2ban-client','-t'])
            for jail in jails:run(['/usr/bin/fail2ban-client','reload',jail])
        for jail in jails:
            loaded=loaded_filter_state(jail)
            expected=[p.strip().replace('%%','%') for p in parse(texts[jail]).get('Definition','failregex').splitlines() if p.strip()]
            if loaded['patterns']!=expected or (jail in sources and set(loaded['paths'])!=set(sources[jail])) or loaded['prefregex'] or loaded['ignoreregex']:
                raise ValueError('Canonical loaded filter/source mismatch: '+jail)
            if jail in sources:
                for key in ('maxretry','findtime','bantime'):
                    if int(native_command(['get',jail,key]))!=payload[key]:raise ValueError('Canonical parameter shadowed')
            ignored={str(ipaddress.ip_network(x,strict=False)) for x in native_command(['get',jail,'ignoreip'])}
            if not required.issubset(ignored):raise ValueError('Canonical whitelist not loaded')
            if FIREWALL['action_specs'](jail,run)!=actions[jail]:raise ValueError('Canonical actions changed')
            coverage=FIREWALL['inspect'](jail,[t['ip'] for t in tickets([jail],native=True)],run)
            if coverage['no_actions'] or coverage['unsupported_actions'] or coverage['missing_ips']:raise ValueError('Canonical coverage unconfirmed')
        verify_preserved_tickets(before)
    except BaseException:
        if changed:
            for j,p in paths.items():atomic_write(p,old[j])
            if previous is None:override.unlink(missing_ok=True)
            else:atomic_write(override,previous)
            for jail in jails:run(['/usr/bin/fail2ban-client','reload',jail])
        raise
    return {'success':True,'jail':'apache-sensitive','jails':list(jails),'changed':changed,'maxretry':payload['maxretry'],'sources':sources,'tickets_checked':len(before)}


def validate_jail(old, new):
    before, after = parse(old), parse(new)
    if before.defaults() != after.defaults():
        raise ValueError('Changing DEFAULT is forbidden')
    allowed = {'enabled', 'filter', 'logpath', 'maxretry', 'findtime', 'bantime', 'ignoreip', 'action'}
    for section in set(before.sections()) | set(after.sections()):
        a = dict(before._sections.get(section, {}))
        b = dict(after._sections.get(section, {}))
        if a == b:
            continue
        if not JAIL.fullmatch(section) or section == 'INCLUDES':
            raise ValueError('Invalid jail section')
        if not b:  # Explicit removal is allowed; global sections never are.
            continue
        for key in set(a) | set(b):
            value = b.get(key, '')
            if a.get(key) == value:
                continue
            if key not in allowed or any(ord(c) < 32 for c in value):
                raise ValueError('Invalid jail field')
            if key == 'enabled' and value not in ('true', 'false'):
                raise ValueError('Invalid enabled flag')
            if key in ('maxretry', 'findtime', 'bantime') and not re.fullmatch(r'-?\d+', value):
                raise ValueError('Invalid numeric field')
            if key == 'filter' and (not JAIL.fullmatch(value) or not (ROOT / 'filter.d' / (value + '.conf')).is_file()):
                raise ValueError('Invalid filter')
            if key == 'logpath' and (not str(Path(value).resolve()).startswith('/var/log/') or '%' in value or '..' in value):
                raise ValueError('Invalid log path')
            if key == 'ignoreip':
                for token in value.split():
                    ipaddress.ip_network(token, strict=False)
            if key == 'action' and not re.fullmatch(r'iptables-multiport\[name=amsfb-[0-9a-f]{16},port="0:65535"\]', value):
                raise ValueError('Only the module firewall action is allowed')
    with tempfile.TemporaryDirectory(prefix='amsfb-config-') as d:
        stage = Path(d)
        for item in ROOT.iterdir():
            if item.name != 'jail.local':
                (stage / item.name).symlink_to(item)
        (stage / 'jail.local').write_text(new)
        run(['/usr/bin/fail2ban-client', '-t', '-c', str(stage)])


def check_ban(jail, ip):
    if not JAIL.fullmatch(jail):
        raise ValueError('Invalid jail')
    ip = str(ipaddress.ip_address(ip))
    state = FIREWALL['inspect'](jail, [ip], run)
    return {'success': True, 'applied': not state['missing_ips'], 'state': state}


def ai_jail_health(seconds):
    jail = 'ai-bans'
    specs = FIREWALL['action_specs'](jail, run)
    expected = len(specs) == 1 and specs[0].get('supported') and specs[0].get('protocol') == 'tcp' and specs[0].get('ranges') == [(0, 65535)]
    duration = run(['/usr/bin/fail2ban-client', 'get', jail, 'bantime']).strip()
    ignored = run(['/usr/bin/fail2ban-client', 'get', jail, 'ignoreip'])
    ignores = set()
    for line in ignored.splitlines():
        try: ignores.add(str(ipaddress.ip_network(line.split()[-1], strict=False)))
        except (ValueError, IndexError): pass
    required = {str(ipaddress.ip_network(x, strict=False)) for x in effective_config().get(jail, {}).get('ignoreip', '').split()}
    pending = tickets([jail], native=True)
    missing = [t['ip'] for t in pending if not check_ban(jail, t['ip'])['applied']]
    cleanup_ready = not pending
    if expected and pending:
        states = native_command(['get',jail,'action',specs[0]['action'],'_CommandAction__started'])
        cleanup_ready = isinstance(states,dict) and all(int(states.get('inet6' if ipaddress.ip_address(t['ip']).version==6 else 'inet4',0)) & 2 for t in pending)
    return {'success': bool(expected and duration == str(seconds) and required <= ignores and not missing and cleanup_ready),
            'action_loaded': bool(expected), 'duration': duration, 'whitelist_confirmed': required <= ignores,
            'missing_ips': missing, 'ticket_count': len(pending), 'native_expiry_ready':cleanup_ready}


def verify_preserved_tickets(before):
    current = {(t['jail'],t['ip']):t['ticket'] for t in tickets(sorted({t['jail'] for t in before}) or ['ai-bans'], native=True)}
    for ticket in before:
        key=(ticket['jail'],ticket['ip'])
        end = ticket['ticket'].rsplit(' = ', 1)[-1]
        expires = time.mktime(time.strptime(end, '%Y-%m-%d %H:%M:%S'))
        if key in current and current[key] != ticket['ticket']:
            raise ValueError('Recovery altered an existing ticket lifetime')
        if expires > time.time()+1 and key not in current:
            raise ValueError('Recovery lost a valid ticket')


def repair_ai_ticket_rules(before):
    """Reconcile only still-identical, valid daemon tickets; never call banip.

    Native restart rounds fractional timestamps in SQLite and can extend a
    ticket by one second. Rebuild the fixed helper-owned action instead.
    """
    specs = FIREWALL['action_specs']('ai-bans', run)
    if not specs:
        # Native reload can drop the newly added action when the old jail had
        # no actions. Attach only the fixed installed action, not caller input.
        from fail2ban.client.actionreader import ActionReader
        action = ActionReader('iptables-multiport','ai-bans',
                              {'name':'amsfb-ai-bans','port':'0:65535'},basedir=str(ROOT))
        if not action.read():
            raise ValueError('Installed AI firewall action unavailable')
        action.getOptions({'bantime':effective_config()['ai-bans']['bantime']})
        for command in action.convert():
            native_command(command)
        specs = FIREWALL['action_specs']('ai-bans', run)
    if len(specs) != 1 or specs[0].get('chain') != 'f2b-amsfb-ai-bans' or specs[0].get('protocol') != 'tcp' or specs[0].get('ranges') != [(0,65535)]:
        raise ValueError('AI action differs from fixed recovery policy: '+json.dumps(specs))
    for ticket in before:
        current = {t['ip']:t['ticket'] for t in tickets(['ai-bans'], native=True)}
        if current.get(ticket['ip']) != ticket['ticket']:
            continue
        expires = time.mktime(time.strptime(ticket['ticket'].rsplit(' = ',1)[-1], '%Y-%m-%d %H:%M:%S'))
        if expires <= time.time()+2:
            continue
        version = ipaddress.ip_address(ticket['ip']).version
        info = {'ip':ticket['ip'],'family':'inet6' if version == 6 else 'inet4'}
        # Invoke only the fixed installed action's ban method, NOT jail banip.
        # This marks the action family as started so native expiry/unban cleans
        # its rule normally, without modifying the BanManager ticket or SQLite.
        arguments = {'aInfo':info}
        if check_ban('ai-bans',ticket['ip'])['applied']:
            # Existing rule from an orphaned action: adopt native cleanup state
            # without inserting a duplicate source rule.
            arguments['cmd'] = '<actioncheck>'
        native_command(['set','ai-bans','action',specs[0]['action'],'ban',json.dumps(arguments)])
        # If it expired during reconciliation, remove only this newly inserted
        # rule; no other jail or historical ban is touched.
        now = {t['ip']:t['ticket'] for t in tickets(['ai-bans'], native=True)}
        if now.get(ticket['ip']) != ticket['ticket'] or expires <= time.time():
            native_command(['set','ai-bans','action',specs[0]['action'],'unban',json.dumps({'aInfo':info})])


def sync_policy(entries):
    if not isinstance(entries, list) or len(entries) > 1000:
        raise ValueError('Invalid whitelist')
    networks = {'127.0.0.0/8', '0.0.0.0/8', '::1/128', '::/128'}
    networks.update(str(ipaddress.ip_network(x, strict=False)) for x in entries)
    policy_name = 'zz-amsfb-safety.local'
    paths = [ROOT / 'jail.conf'] + sorted((ROOT / 'jail.d').glob('*.conf')) + [ROOT / 'jail.local']
    paths += [p for p in sorted((ROOT / 'jail.d').glob('*.local')) if p.name not in (policy_name, '98-amsfb-safety.local')]
    baseline = configparser.RawConfigParser(strict=False)
    baseline.read([str(p) for p in paths if p.is_file()])
    def merged(value):
        if '%' in value:
            raise ValueError('Resolve existing ignoreip interpolation before policy sync')
        return ' '.join(sorted(set(value.split()) | networks))
    value = merged(baseline.defaults().get('ignoreip', ''))
    body = '# Managed AMSFB protection policy. No action/filter changes.\n[DEFAULT]\nignoreip = ' + value + '\n'
    for jail in sorted(baseline.sections()):
        if JAIL.fullmatch(jail) and jail != 'INCLUDES':
            body += '\n[' + jail + ']\nignoreip = ' + merged(baseline.get(jail, 'ignoreip', fallback='')) + '\n'
    with tempfile.TemporaryDirectory(prefix='amsfb-policy-') as d:
        stage = Path(d)
        for item in ROOT.iterdir():
            if item.name != 'jail.d':
                (stage / item.name).symlink_to(item)
        (stage / 'jail.d').mkdir()
        for item in (ROOT / 'jail.d').iterdir():
            if item.name != policy_name:
                (stage / 'jail.d' / item.name).symlink_to(item)
        (stage / 'jail.d' / policy_name).write_text(body)
        run(['/usr/bin/fail2ban-client', '-t', '-c', str(stage)])
    dest = ROOT / 'jail.d' / policy_name
    old = dest.read_text() if dest.exists() else None
    try:
        if old != body:
            atomic_write(dest, body)
            run(['/usr/bin/fail2ban-client', 'reload'])
        for section, settings in effective_config().items():
            effective = {str(ipaddress.ip_network(x, strict=False)) for x in settings.get('ignoreip', '').split()}
            if not networks.issubset(effective):
                raise ValueError('A later override shadows the safety whitelist: ' + section)
    except Exception:
        if old is None:
            dest.unlink(missing_ok=True)
        else:
            atomic_write(dest, old)
        run(['/usr/bin/fail2ban-client', 'reload'])
        raise
    return {'success': True}


def effective_config():
    from fail2ban.client.jailsreader import JailsReader
    reader = JailsReader()
    reader.setBaseDir(str(ROOT))
    if not reader.read():
        raise ValueError('Native configuration could not be read')
    fields = ('enabled', 'filter', 'logpath', 'maxretry', 'findtime', 'bantime', 'ignoreip', 'backend')
    result = {}
    for section in reader.sections():
        if JAIL.fullmatch(section) and section != 'INCLUDES':
            result[section] = {}
            for key in fields:
                try:
                    result[section][key] = reader.get(section, key)
                except (configparser.Error, KeyError):
                    pass
    return result


def ensure_ai_jail(duration):
    seconds = int(duration)
    if not 300 <= seconds <= 31536000:
        raise ValueError('Invalid ban duration')
    dest = ROOT / 'jail.d' / 'zz-amsfb-ai.local'
    filter_path = ROOT / 'filter.d' / 'amsfb-ai-manual.conf'
    text = ('[ai-bans]\nenabled = true\nfilter = amsfb-ai-manual\n'
            'logpath = /var/log/whmcs_auth.log\nmaxretry = 1\nfindtime = 600\n'
            f'bantime = {seconds}\naction = iptables-multiport[name=amsfb-ai-bans,port="0:65535"]\n'
            '\n# Legacy echo filter learned administrative ban commands, not attacks.\n'
            '[amsfb-ai-bans]\nenabled = false\n')
    if not Path('/var/log/whmcs_auth.log').is_file():
        raise ValueError('WHMCS authentication log missing')
    old = dest.read_text() if dest.exists() else None
    configured=effective_config().get('ai-bans',{})
    try:
        active=tickets(['ai-bans'],native=True)
    except ValueError:
        active=[]
    if active and str(configured.get('bantime',''))!=str(seconds):
        raise ValueError('Bans ativos na jail da IA: mudar a duração exige prévia de manutenção ou aguardar a expiração; tickets antigos não serão alterados')
    if not filter_path.exists():
        atomic_write(filter_path, '[Definition]\nfailregex = ^AMSFB manual ticket from <HOST>$\nignoreregex =\n')
    if old == text and 'ai-bans' in effective_config():
        try:
            health = ai_jail_health(seconds)
            if health['success']:
                return health
        except subprocess.CalledProcessError:
            pass
    try:
        before = active
        if old != text:
            atomic_write(dest, text)
        run(['/usr/bin/fail2ban-client', '-t'])
        run(['/usr/bin/fail2ban-client', 'reload', 'ai-bans'])
        health = ai_jail_health(seconds)
        if not health['success']:
            if before:
                repair_ai_ticket_rules(before)
            else:
                run(['/usr/bin/fail2ban-client', 'reload', '--restart', 'ai-bans'])
            for _ in range(20):
                health = ai_jail_health(seconds)
                if health['success']:
                    break
                time.sleep(.1)
        verify_preserved_tickets(before)
        if not health['success']:
            raise ValueError('AI jail recovery did not confirm its own firewall action/tickets')
        return dict(health, recovered=True)
    except Exception:
        if old is None:
            dest.unlink(missing_ok=True)
        else:
            atomic_write(dest, old)
        run(['/usr/bin/fail2ban-client', 'reload', 'ai-bans'])
        raise


def native_command(command):
    # Installed Fail2Ban client protocol, fixed internal commands only. Avoid
    # spawning a full CLI twice for every ticket in a large maintenance job.
    from fail2ban.client.csocket import CSocket
    client = CSocket(timeout=20)
    try:
        code, result = client.send(command)
        if code != 0:
            raise ValueError('Fail2Ban daemon rejected ticket operation: ' + str(result))
        return result
    finally:
        client.close()


def tickets(jails, native=False):
    result = []
    for jail in jails:
        if not JAIL.fullmatch(jail):
            raise ValueError('Invalid jail')
        lines = native_command(['get', jail, 'banip', '--with-time']) if native else run(['/usr/bin/fail2ban-client', 'get', jail, 'banip', '--with-time']).splitlines()
        for line in lines:
            # Keep the full daemon ticket (start + duration + end). A renewed
            # ban after preview must never match this identity.
            match = re.match(r'^\s*([0-9a-fA-F:.]+)\s+(.+)$', line)
            if match:
                result.append({'jail':jail, 'ip':str(ipaddress.ip_address(match[1])), 'ticket':match[2].strip()})
            elif line.strip() and line.strip() not in ('[]',):
                raise ValueError('Unsupported ban ticket format')
    return result


def ips_snapshot():
    """Presentation only. Fixed read commands; no shell, writes or ban admission."""
    observed = int(time.time())

    def pairs(value):
        if not isinstance(value, (list, tuple)):
            raise ValueError('Invalid native mapping')
        result = {}
        for pair in value:
            if not isinstance(pair, (list, tuple)) or len(pair) != 2 or not isinstance(pair[0], str) or pair[0] in result:
                raise ValueError('Invalid native field')
            result[pair[0]] = pair[1]
        return result

    def names():
        data = pairs(native_command(['status']))
        count, value = data.get('Number of jail'), data.get('Jail list')
        if type(count) is not int or not 0 <= count <= 200 or not isinstance(value, str):
            raise ValueError('Invalid inventory')
        rows = [v.strip() for v in value.split(',')] if value.strip() else []
        if len(rows) != count or len(set(rows)) != count or any(not JAIL.fullmatch(v) for v in rows):
            raise ValueError('Inconsistent inventory')
        return sorted(rows)

    def status(jail):
        data = pairs(native_command(['status', jail]))
        filtering, actions = pairs(data.get('Filter')), pairs(data.get('Actions'))
        result = {}
        for key, source, label in [('currently_failed', filtering, 'Currently failed'), ('total_failed', filtering, 'Total failed'),
                                   ('currently_banned', actions, 'Currently banned'), ('total_banned', actions, 'Total banned')]:
            value = source.get(label)
            if type(value) is not int or not 0 <= value <= 9007199254740991:
                raise ValueError('Invalid counter')
            result[key] = value
        peers = actions.get('Banned IP list')
        if not isinstance(peers, (list, tuple)) or len(peers) > 50000 or any(not isinstance(ip, str) for ip in peers):
            raise ValueError('Invalid peers')
        peers = [str(ipaddress.ip_address(ip)) for ip in peers]
        if len(set(peers)) != len(peers) or len(peers) != result['currently_banned']:
            raise ValueError('Inconsistent peers')
        result['banned_ip_list'] = sorted(peers)
        return result

    before = names()
    statuses, targets, errors = {}, [], []
    for jail in before:
        try:
            first = status(jail)
            identities = tickets([jail], native=True)
            if len(identities) + len(targets) > 50000:
                raise ValueError('Snapshot too large')
            peers = []
            for row in identities:
                identity = row.get('ticket')
                if row.get('jail') != jail or not isinstance(identity, str) or not 1 <= len(identity) <= 200 or re.search(r'[\x00-\x1f\x7f]', identity):
                    raise ValueError('Invalid temporal identity')
                peers.append(row['ip'])
            last = status(jail)
            if len(set(peers)) != len(peers) or sorted(peers) != first['banned_ip_list'] or sorted(peers) != last['banned_ip_list']:
                raise ValueError('Tickets changed during read')
            repeated = tickets([jail], native=True)
            identity = lambda rows: sorted((r['ip'], r['ticket']) for r in rows)
            if identity(identities) != identity(repeated):
                raise ValueError('Ticket renewed during read')
            statuses[jail] = last
            targets.extend(identities)
        except Exception:
            statuses[jail] = None
            errors.append(jail)
    stable = names() == before
    return {'success': True, 'snapshot_version': 1, 'observed_at': observed, 'finished_at': int(time.time()),
            'inventory_stable': stable, 'complete': stable and not errors, 'names': before,
            'statuses': statuses if stable else {}, 'targets': targets if stable else [],
            'errors': errors}


def archive_part(job, part, path):
    if not re.fullmatch(r'[a-f0-9]{32}', job) or not re.fullmatch(r'[0-9]{1,4}', part):
        raise ValueError('Invalid archive identity')
    body = temporary(path, 'amsfb_archive_')
    json.loads(body)
    target = BACKUPS / ('job-' + job)
    target.mkdir(parents=True, mode=0o700, exist_ok=True)
    os.chmod(target, 0o700)
    dest = target / ('part-' + part + '.json.bakp')
    if dest.exists() and dest.read_text() != body:
        raise ValueError('Archive part already exists with different content')
    if not dest.exists():
        atomic_write(dest, body, 0o600)
    digest = hashlib.sha256(body.encode()).hexdigest()
    if hashlib.sha256(dest.read_bytes()).hexdigest() != digest:
        raise ValueError('Archive verification failed')
    return {'success': True, 'sha256': digest, 'bytes':dest.stat().st_size, 'part':int(part)}


def unban_ticket(jail, ip, identity):
    ip = str(ipaddress.ip_address(ip))
    if not any(x['ip'] == ip and x['ticket'] == identity for x in tickets([jail], native=True)):
        return {'success': True, 'skipped':True}
    try:
        native_command(['set', jail, 'unbanip', ip])
    except Exception:
        if not any(x['ip']==ip and x['ticket']==identity for x in tickets([jail],native=True)):
            return {'success':True,'skipped':True}
        raise
    return {'success': True, 'skipped':False}


def verify_archive(job, manifest):
    if not re.fullmatch(r'[a-f0-9]{32}',job) or not isinstance(manifest,list) or not 1<=len(manifest)<=10000:
        raise ValueError('Invalid archive manifest')
    for part in manifest:
        if not isinstance(part,dict) or not isinstance(part.get('part'),int) or not 0<=part['part']<=9999:
            raise ValueError('Invalid archive part')
        if not re.fullmatch(r'[a-f0-9]{64}',str(part.get('sha256',''))):
            raise ValueError('Invalid archive digest')
        path=BACKUPS/('job-'+job)/('part-'+str(part['part'])+'.json.bakp')
        if path.stat().st_size != part.get('bytes') or hashlib.sha256(path.read_bytes()).hexdigest()!=part['sha256']:
            raise ValueError('Archive integrity mismatch; recovery refused')
    return {'success':True,'verified_parts':len(manifest)}


def unban_batch(targets):
    if not isinstance(targets,list) or not 1 <= len(targets) <= 100:
        raise ValueError('Invalid ticket batch')
    # Validate the entire shape first; never expose arbitrary daemon commands.
    for target in targets:
        if not isinstance(target,dict) or set(target) != {'jail','ip','ticket'}:
            raise ValueError('Invalid ticket fields')
        if not isinstance(target['jail'],str) or not JAIL.fullmatch(target['jail']):
            raise ValueError('Invalid jail')
        ipaddress.ip_address(target['ip'])
        if not isinstance(target['ticket'],str) or len(target['ticket'])>200 or '\n' in target['ticket']:
            raise ValueError('Invalid temporal identity')
    results=[]
    for target in targets:
        try:
            results.append(unban_ticket(target['jail'],target['ip'],target['ticket']))
        except Exception as exc:
            return {'success':True,'results':results,'error':'Partial batch: '+str(exc)}
    return {'success':True,'results':results}


def monitor(job, hours=None, interval=None):
    if not re.fullmatch(r'[a-f0-9]{32}', job):
        raise ValueError('Invalid monitor identity')
    folder = BACKUPS / ('job-' + job)
    folder.mkdir(mode=0o700, parents=True, exist_ok=True)
    report = folder / 'monitor.jsonl'
    unit = 'amsfb-monitor-' + job
    if hours is not None:
        if not 1 <= int(hours) <= 168 or not 30 <= int(interval) <= 3600:
            raise ValueError('Invalid monitor window')
        if not report.exists():
            report.touch(mode=0o600)
            run(['/usr/bin/systemd-run', '--unit=' + unit, '--property=Type=exec',
                 '--property=StandardOutput=append:' + str(report),
                 '--property=StandardError=journal', '/usr/bin/python3',
                 '/usr/local/lib/amssoft_fail2ban/audit.py', '--monitor-hours', str(hours),
                 '--interval', str(interval)])
    state = run(['/usr/bin/systemctl', 'show', unit, '--property=ActiveState,Result,ExecMainStatus'])
    samples = errors = missing = orphan = 0
    missing_tickets = None
    no_actions = set()
    unsupported = set()
    measured = 0
    coverage_versions = set()
    finished = False
    first = last = None
    if report.exists():
        if report.stat().st_size > 50 * 1024 * 1024:
            raise ValueError('Monitor report exceeds limit')
        with report.open() as source:
            for line in source:
                try:
                    value = json.loads(line)
                except ValueError:
                    continue
                if value.get('monitor_complete'):
                    finished = True
                    continue
                samples += 1
                errors += bool(value.get('error'))
                missing = max(missing, int(value.get('missing_f2b_rules', 0)))
                orphan = max(orphan, int(value.get('orphan_firewall_ips',0)))
                if value.get('coverage_version') in (2, 3, 4):
                    measured += 1
                    coverage_versions.add(value['coverage_version'])
                    missing_tickets = max(missing_tickets or 0, int(value.get('missing_jail_tickets',0)))
                    no_actions.update(value.get('jails_without_actions',[]))
                    unsupported.update(value.get('jails_unverified',[]))
                first = first or value
                last = value
    active = 'ActiveState=active' in state or 'ActiveState=activating' in state
    return {'success': True, 'active':active, 'samples':samples, 'errors':errors,
            'max_missing_rules':missing, 'max_orphan_rules':orphan, 'first':first, 'last':last,
            'coverage_samples':measured,'coverage_versions_seen':sorted(coverage_versions),'max_missing_jail_tickets':missing_tickets,
            'jails_without_actions_seen':sorted(no_actions) if measured else None,
            'jails_unverified_seen':sorted(unsupported) if measured else None,
            'completed':not active and samples > 0 and (finished or ('Result=success' in state and 'ExecMainStatus=0' in state))}


def loaded_filter_state(jail):
    if not JAIL.fullmatch(jail):
        raise ValueError('Invalid jail')
    from fail2ban.server.failregex import FailRegex
    # get failregex returns expanded native macros. Reverse only an exact,
    # known HOST expansion, never an arbitrary capture or a guessed regex edit.
    expansions = sorted({FailRegex('<HOST>', useDns=dns).getRegex() for dns in ('no', 'warn', 'yes')}, key=len, reverse=True)
    patterns = []
    for pattern in native_command(['get', jail, 'failregex']):
        for expansion in expansions:
            if pattern.count(expansion) == 1:
                patterns.append(pattern.replace(expansion, '<HOST>'))
                break
        else:
            raise FilterValidationError('loaded_filter_host', 'Loaded expression has no verifiable native HOST expansion')
    return {'success': True, 'patterns': patterns,
            'prefregex': native_command(['get', jail, 'prefregex']),
            'ignoreregex': native_command(['get', jail, 'ignoreregex']),
            'paths': native_command(['get', jail, 'logpath'])}


