FIREWALL = runpy.run_path(str(_state_path))


class FilterValidationError(ValueError):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code

ROOT = Path('/etc/fail2ban')
BACKUPS = Path('/var/backups/amssoft_fail2ban')
JAIL = re.compile(r'[A-Za-z0-9][A-Za-z0-9_-]{0,63}\Z')
FILTER = re.compile(r'[a-z0-9][a-z0-9-]{0,49}\Z')
logging.disable(logging.CRITICAL)


def run(args):
    return subprocess.check_output(args, text=True, stderr=subprocess.DEVNULL, timeout=30)


def temporary(path, prefix):
    p = Path(path)
    if p.parent != Path('/tmp') or not p.name.startswith(prefix):
        raise ValueError('Invalid temporary path')
    fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'r') as f:
        info = os.fstat(f.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != int(os.environ.get('SUDO_UID', os.getuid())):
            raise ValueError('Invalid temporary owner/type')
        if info.st_size > 2 * 1024 * 1024:
            raise ValueError('Input too large')
        return f.read()


def parse(text):
    c = configparser.RawConfigParser(strict=False)
    c.read_string(text)
    return c


NORMAL_PATH_DEFAULTS = ['/', '/clientarea.php', '/robots.txt', '/favicon.ico',
                        '/retired-page', '/index.php', '/login', '/checkout.php', '/license.php']


def validate_normal_paths(payload):
    if not isinstance(payload, dict) or set(payload) != {'paths'}:
        raise ValueError('Invalid normal route fields')
    paths = payload['paths']
    if not isinstance(paths, list) or len(paths) > 50:
        raise ValueError('Invalid normal route count')
    if any(not isinstance(p, str) or len(p) > 200
           or not re.fullmatch(r'/[A-Za-z0-9_./-]*', p) for p in paths):
        raise ValueError('Invalid literal normal route')
    return list(dict.fromkeys(paths))


def normal_paths():
    path = ROOT / 'amsfb-normal-paths.json'
    if not path.exists():
        return NORMAL_PATH_DEFAULTS
    # Root-owned bounded catalogue. Corruption refuses validation, not safety.
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd) as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_size > 16384:
            raise ValueError('Invalid normal route catalogue')
        return validate_normal_paths(json.load(stream))


def sync_normal_paths(payload):
    paths = validate_normal_paths(payload)
    dest = ROOT / 'amsfb-normal-paths.json'
    text = json.dumps({'paths': paths}, ensure_ascii=True) + '\n'
    if dest.exists() and dest.read_text() == text:
        return {'success': True, 'changed': False, 'count': len(paths)}
    atomic_write(dest, text)
    return {'success': True, 'changed': True, 'count': len(paths)}


