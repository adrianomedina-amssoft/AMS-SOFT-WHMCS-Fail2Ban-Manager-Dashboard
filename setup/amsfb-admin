class ReadBudgetExceeded(BaseException):
    code = 'cycle_budget'


def budget_expired(signum, frame):
    # Escape native validators' broad Exception handlers without becoming a syntax refusal.
    raise ReadBudgetExceeded('Read/validation time budget exhausted')


def prepare_budget(args):
    if args and args[0] == '--read-budget':
        if len(args) < 3 or not re.fullmatch(r'[1-9][0-9]?', args[1]) or not 1 <= int(args[1]) <= 45:
            raise ValueError('Invalid read budget')
        args, seconds = args[2:], int(args[1])
        if args[0] not in READ_OPERATIONS:
            raise ValueError('Budget is restricted to read/validation operations')
        signal.signal(signal.SIGALRM, budget_expired)
        signal.alarm(seconds)
    return args


def native_action_specs(jail):
    """Same firewall parser, fixed daemon reads instead of one CLI per field."""
    if not isinstance(jail, str) or not JAIL.fullmatch(jail):
        raise ValueError('Invalid jail')
    names = native_command(['get', jail, 'actions'])
    if (not isinstance(names, list) or len(names) > 100
            or any(not isinstance(name, str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]{0,127}', name) for name in names)
            or len(set(names)) != len(names)):
        raise ValueError('Invalid native actions')

    def read(command):
        if command == ['/usr/bin/fail2ban-client', 'get', jail, 'actions']:
            return 'Actions:\n' + '\n'.join(names)
        if (len(command) != 6 or command[:4] != ['/usr/bin/fail2ban-client', 'get', jail, 'action']
                or command[4] not in names or command[5] not in ('actionban', 'protocol', 'port')):
            raise ValueError('Unexpected action read')
        value = native_command(command[1:])
        if not isinstance(value, str) or len(value) > 16384 or '\x00' in value:
            raise ValueError('Invalid native action property')
        return value

    return FIREWALL['action_specs'](jail, read)


def ban_coverage(ips=None, services=False, native_actions=False):
    """Read-only, HTTP scope; a daemon ticket alone never proves protection."""
    observed = int(time.time())
    # Cache literal CIDR parsing only for this dashboard invocation. Tickets,
    # rules, action properties and protection decisions are never cached.
    network_reader = functools.lru_cache(maxsize=4096)(ipaddress.ip_network) if native_actions else None
    names = dict(native_command(['status'])).get('Jail list', '')
    jails = [name.strip() for name in names.split(',') if name.strip()]
    rules = {v: FIREWALL['read_rules'](run, v) for v in (4, 6)}
    before = tickets(jails, native=True)
    requirements = {'http': [80, 443]}
    if services:
        ssh = set()
        for jail, cfg in effective_config().items():
            if jail not in jails or cfg.get('filter', '').split('[', 1)[0] != 'sshd':
                continue
            for lo, hi in FIREWALL['ranges'](cfg.get('port', 'ssh'), 'tcp'):
                if hi-lo > 100: raise ValueError('Ambiguous SSH service ports')
                ssh.update(range(lo, hi+1))
        requirements['ssh'] = sorted(ssh)
    required_ports = set(p for ports in requirements.values() for p in ports)
    entries, errors = [], []
    for jail in jails:
        try:
            pending = [ticket for ticket in before if ticket['jail'] == jail]
            if ips is not None:
                pending = [ticket for ticket in pending if ticket['ip'] in ips]
            if not pending:
                continue
            specs = native_action_specs(jail) if native_actions else FIREWALL['action_specs'](jail, run)
            if any(not spec.get('supported') for spec in specs):
                errors.append({'jail': jail, 'error': 'unsupported_action'})
            for ticket in pending:
                identity = ticket['ticket']
                try:
                    expires = int(time.mktime(time.strptime(identity.rsplit(' = ', 1)[-1], '%Y-%m-%d %H:%M:%S')))
                except (ValueError, OverflowError):
                    # Permanent tickets may have no calendar end. Unknown formats
                    # are not assumed permanent and cannot suppress analysis.
                    if not re.search(r'\+\s*-1\s*=', identity):
                        continue
                    expires = None
                if expires is not None and expires <= time.time():
                    continue
                version = ipaddress.ip_address(ticket['ip']).version
                ports = set()
                for spec in specs:
                    if not spec.get('supported') or spec.get('protocol') != 'tcp':
                        continue
                    for port in required_ports:
                        if any(lo <= port <= hi for lo, hi in spec['ranges']):
                            scoped = dict(spec, ranges=[(port, port)])
                            covered = (FIREWALL['covers'](rules[version], scoped, ticket['ip'], network_reader=network_reader)
                                       if native_actions else FIREWALL['covers'](rules[version], scoped, ticket['ip']))
                            if covered:
                                ports.add(port)
                if ports:
                    entries.append(dict(ticket, expires_at=expires, protocol='tcp', ports=sorted(ports), effective=True))
        except Exception as exc:
            errors.append({'jail': jail, 'error': type(exc).__name__})
    # A snapshot is observational, never an instruction to ban/unban.
    after = tickets(jails, native=True)
    identity = lambda rows: sorted((r['jail'], r['ip'], r['ticket']) for r in rows)
    stable = identity(before) == identity(after) and rules == {v: FIREWALL['read_rules'](run, v) for v in (4, 6)}
    stable = stable and names == dict(native_command(['status'])).get('Jail list', '')
    return {'success': stable and not errors, 'stable': stable, 'observed_at': observed,
            'entries': entries if stable else [], 'errors': errors, 'requirements': requirements,
            'scope': 'configured services' if services else 'HTTP TCP 80/443'}


def prepare_evidence(lines):
    if not isinstance(lines, list) or len(lines) > 1000 or any(not isinstance(x, str) or len(x) >= 65536 for x in lines):
        raise ValueError('Invalid evidence lines')
    from fail2ban.server.datedetector import DateDetector
    detector = DateDetector()
    detector.addDefaultTemplate()
    prepared = {}
    for line in lines:
        match = detector.matchTime(line)[0]
        prepared[hashlib.sha256(line.encode()).hexdigest()] = line[:match.start(1)] + line[match.end(1):] if match else line
    return {'success': True, 'lines': prepared}


def main(args):
    if not args:
        raise ValueError('Missing operation')
    if args[0] == 'client-read':
        command = args[1:]
        if command not in (['status'], ['ping']):
            if len(command) != 2 or command[0] != 'status' or not JAIL.fullmatch(command[1]):
                raise ValueError('Invalid read command')
        return {'success': True, 'output': run(['/usr/bin/fail2ban-client'] + command)}
    if args == ['health']:
        return {'success': True, 'version': 30}
    if args == ['ips-snapshot']:
        return ips_snapshot()
    if args == ['dashboard-protection-snapshot']:
        return ban_coverage(services=True, native_actions=True)
    if args[0] == 'sync-sensitive-probes' and len(args) == 2:
        return sync_sensitive_probes(json.loads(temporary(args[1], 'amsfb_probes_')))
    if args[0] == 'filter-coverage' and len(args) == 3:
        if not JAIL.fullmatch(args[1]):raise ValueError('Invalid jail')
        return filter_coverage(args[1], json.loads(temporary(args[2], 'amsfb_evidence_')))
    if args[0] == 'extend-managed-rule' and len(args) == 2:
        return extend_managed_rule(json.loads(temporary(args[1], 'amsfb_rule_')))
    if args[0] == 'normalize-filter' and len(args) == 2:
        return normalize_evidence_filter(json.loads(temporary(args[1], 'amsfb_evidence_')))
    if args[0] == 'ban-coverage' and 1 <= len(args) <= 11:
        return ban_coverage({str(ipaddress.ip_address(ip)) for ip in args[1:]} if len(args)>1 else None)
    if args[0] == 'prepare-evidence' and len(args) == 2:
        return prepare_evidence(json.loads(temporary(args[1], 'amsfb_evidence_')))
    if args[0] == 'protection-snapshot' and 1 <= len(args) <= 11:
        ips = {str(ipaddress.ip_address(ip)) for ip in args[1:]} if len(args) > 1 else None
        return ban_coverage(ips, services=True)
    if args[0] == 'jail-filter-state' and len(args) == 2:
        return loaded_filter_state(args[1])
    if args[0] == 'replace-filter' and len(args) == 5:
        return replace_existing_filter(args[2], temporary(args[1], 'amsfb_filter_'), args[3],
                                       json.loads(temporary(args[4], 'amsfb_evidence_')))
    if args[0] == 'quarantine-detection' and len(args) == 3:
        return replace_existing_filter(args[1], '', args[2], [], quarantine=True)
    if args[0] == 'reload' and len(args) in (1, 2):
        if len(args) == 2 and not JAIL.fullmatch(args[1]):
            raise ValueError('Invalid jail')
        run(['/usr/bin/fail2ban-client', 'reload'] + args[1:])
        return {'success': True}
    if args == ['effective-config']:
        return {'success': True, 'jails': effective_config()}
    if args == ['ai-jail-health']:
        return ai_jail_health(effective_config().get('ai-bans', {}).get('bantime', '3600'))
    if args[0] == 'ensure-ai-jail' and len(args) == 2:
        return ensure_ai_jail(args[1])
    if args[0] == 'tickets' and 2 <= len(args) <= 201:
        return {'success': True, 'targets':tickets(args[1:])}
    if args[0] == 'unban-ticket' and len(args) == 4:
        return unban_ticket(*args[1:])
    if args[0] == 'unban-tickets' and len(args) == 2:
        return unban_batch(json.loads(temporary(args[1], 'amsfb_targets_')))
    if args[0] == 'archive-part' and len(args) == 4:
        return archive_part(*args[1:])
    if args[0] == 'verify-archive' and len(args) == 3:
        return verify_archive(args[1],json.loads(temporary(args[2],'amsfb_manifest_')))
    if args[0] == 'monitor-start' and len(args) == 4:
        return monitor(*args[1:])
    if args[0] == 'monitor-status' and len(args) == 2:
        return monitor(args[1])
    if args == ['audit-snapshot']:
        result = subprocess.run(['/usr/bin/python3', '/usr/local/lib/amssoft_fail2ban/audit.py'],
                                text=True, capture_output=True, timeout=40)
        value = json.loads(result.stdout)
        return {'success':not bool(value.get('error')), 'snapshot':value}
    if args[0] == 'check-ban' and len(args) == 3:
        return check_ban(args[1], args[2])
    if args[0] in ('ban','unban') and len(args) == 3:
        jail, ip = args[1:]
        if not JAIL.fullmatch(jail):
            raise ValueError('Invalid jail')
        address = ipaddress.ip_address(ip)
        if args[0] == 'ban':
            peer = address.ipv4_mapped if address.version == 6 and address.ipv4_mapped else address
            if peer.is_loopback or peer.is_unspecified or (peer.version == 4 and int(peer) >> 24 == 0):
                raise ValueError('Protected address')
            ignores = run(['/usr/bin/fail2ban-client', 'get', jail, 'ignoreip'])
            for line in ignores.splitlines():
                try:
                    network = ipaddress.ip_network(line.split()[-1], strict=False)
                except (ValueError, IndexError):
                    continue
                if address.version == network.version and address in network:
                    raise ValueError('Whitelisted address')
        run(['/usr/bin/fail2ban-client', 'set', jail, args[0] + 'ip', str(address)])
        return {'success': True, 'accepted': True}
    if args[0] == 'sync-policy' and len(args) == 2:
        return sync_policy(json.loads(temporary(args[1], 'amsfb_policy_')))
    if args[0] == 'sync-normal-paths' and len(args) == 2:
        return sync_normal_paths(json.loads(temporary(args[1], 'amsfb_normal_')))
    if args[0] == 'validate-filter' and len(args) == 3:
        text = temporary(args[1], 'amsfb_filter_')
        evidence = json.loads(temporary(args[2], 'amsfb_evidence_'))
        if not isinstance(evidence, list):
            raise ValueError('Invalid evidence')
        from fail2ban.server.failregex import RegexException
        try: result=validate_filter(text, evidence)
        except RegexException as exc:
            raise FilterValidationError('filter_syntax','Invalid fail2ban expression') from exc
        return {'success': True,**result}
    if args[0] == 'install-filter' and len(args) == 4:
        text = temporary(args[1], 'amsfb_filter_')
        name = args[2]
        if not FILTER.fullmatch(name) or name.startswith('amsfb-'):
            raise ValueError('Invalid filter name')
        evidence = json.loads(temporary(args[3], 'amsfb_evidence_'))
        if not isinstance(evidence, list):
            raise ValueError('Invalid evidence')
        validate_filter(text, evidence)
        atomic_write(ROOT / 'filter.d' / ('amsfb-' + name + '.conf'), text)
        return {'success': True}
    if args[0] == 'install-jail' and len(args) == 3:
        text = temporary(args[1], 'amsfb_jail_')
        current = (ROOT / 'jail.local').read_text()
        if hashlib.sha256(current.encode()).hexdigest() != args[2]:
            raise ValueError('Configuration changed concurrently')
        validate_jail(current, text)
        before,after=parse(current),parse(text)
        atomic_write(ROOT / 'jail.local', text)
        try:
            run(['/usr/bin/fail2ban-client','reload'])
            effective=effective_config()
            for section in after.sections():
                requested=after._sections[section].get('enabled')
                previous=before._sections.get(section,{}).get('enabled')
                if requested is not None and requested!=previous:
                    state=effective.get(section,{}).get('enabled','false').lower() in ('true','1','yes','on')
                    if state != (requested=='true'):
                        raise ValueError('A later override shadows the jail activation state')
                    if state:
                        run(['/usr/bin/fail2ban-client','status',section])
        except Exception:
            atomic_write(ROOT / 'jail.local',current)
            run(['/usr/bin/fail2ban-client','reload'])
            raise
        return {'success': True}
    if args[0] == 'quarantine-filter' and len(args) == 2:
        name=args[1]
        if not FILTER.fullmatch(name) or name.startswith('amsfb-'):
            raise ValueError('Invalid filter name')
        full='amsfb-'+name
        if any(settings.get('filter','').split('[',1)[0]==full for settings in effective_config().values()):
            return {'success':False,'error':'Filter still has a configuration consumer'}
        path=ROOT/'filter.d'/(full+'.conf')
        if not path.exists():return {'success':True,'absent':True}
        BACKUPS.mkdir(mode=0o700,parents=True,exist_ok=True)
        saved=BACKUPS/('unused-'+full+'.'+str(time.time_ns())+'.bakp')
        shutil.copy2(path,saved);os.chmod(saved,0o600)
        if hashlib.sha256(saved.read_bytes()).digest()!=hashlib.sha256(path.read_bytes()).digest():
            raise ValueError('Unused filter backup mismatch')
        path.unlink()
        return {'success':True,'quarantined':True}
    raise ValueError('Unsupported operation')


if __name__ == '__main__':
    try:
        signal.alarm(45)
        args = prepare_budget(sys.argv[1:])
        if args and args[0] in READ_OPERATIONS:
            # Files are replaced atomically. Observational calls need not wait
            # behind a large maintenance batch; they never change host state.
            print(json.dumps(main(args)))
        else:
            # Serializes privileged commits; PHP also locks read/modify/write.
            with open('/run/lock/amsfb-admin.lock', 'a') as lock:
                fcntl.flock(lock, fcntl.LOCK_EX)
                print(json.dumps(main(args)))
    except (Exception, ReadBudgetExceeded) as exc:
        print(json.dumps({'success': False, 'error': str(exc),
                          'code': getattr(exc, 'code', 'bridge_error')}))
        sys.exit(1)
