def filter_coverage(jail, evidence):
    state = loaded_filter_state(jail)
    if state['prefregex'] or state['ignoreregex']:
        raise FilterValidationError('loaded_filter_context', 'Contextual filter cannot be independently checked')
    text = '[Definition]\nfailregex = ' + '\n            '.join(p.replace('%', '%%') for p in state['patterns']) + '\nignoreregex =\n'
    covered = 0
    with tempfile.TemporaryDirectory(prefix='amsfb-probe-') as directory:
        path = Path(directory) / 'probe.conf'
        path.write_text(text)
        for line in evidence:
            if not isinstance(line, str) or len(line) > 65535:
                continue
            peer = source_peer(line)
            captured = matches(path, [line], peers=True)
            if captured:
                try:
                    exact = peer is not None and all(str(ipaddress.ip_address(a)) == peer for a in captured)
                except ValueError:
                    exact = False
                if not exact:
                    raise FilterValidationError('filter_peer', 'Loaded expression captures another peer')
                covered += 1
    return {'success': True, 'covered': covered, 'paths': state['paths']}


def normalize_evidence_filter(payload):
    patterns=payload['patterns'];evidence=payload['evidence'];normalized=[]
    if not isinstance(patterns,list) or len(patterns)>10:raise ValueError('Invalid expression list')
    for pattern in patterns:
        value=pattern
        # Only the literal timestamp header is normalized; never a target,
        # peer, status, verb or other part of the expression.
        if pattern.startswith('^<HOST> - ') and evidence and all(re.match(r'^\S+\s+-\s+',line) for line in evidence):
            left=pattern.find(r'\[')
            endings=[p for marker in (r'\] "',r'\] \"') if (p:=pattern.find(marker,left+2))>=0]
            if 0<=left<=35 and endings:value=pattern[:left]+r'\[\s*\]'+pattern[min(endings)+2:]
        elif pattern.startswith(r'^\[') and evidence and all(re.match(r'^\[',line) for line in evidence):
            endings=[p for marker in (r'\]\s+',r'\] ') if (p:=pattern.find(marker,3))>=0]
            if endings:value=r'^\[\s*\]'+pattern[min(endings)+2:]
        normalized.append(value)
    text='[Definition]\nfailregex = '+'\n            '.join(p.replace('%','%%') for p in normalized)+'\nignoreregex =\n'
    fallback = False
    try:
        validate_filter(text,evidence)
    except FilterValidationError as exc:
        if exc.code != 'filter_positive':
            raise
        # Only closed SQL payloads from one peer, complete raw request targets,
        # every cited event retained, bounded total regex. Never repair a broad
        # identity/legitimate/peer refusal or silently omit mixed evidence.
        alternatives=[];peers=set()
        for line in evidence:
            m=re.match(r'^\S+ - \S+ \[[^\]\r\n]*\] "([A-Z]{3,12}) ([^ "\r\n]{1,8192}) HTTP/\d(?:\.\d)?" [1-5]\d\d (?:\d+|-)(?: |$)',line)
            peer=source_peer(line)
            if not m or not peer or not sql_target(m[2]):
                raise exc
            peers.add(peer)
            alternatives.append(re.escape(m[1]+' '+m[2]))
        if not alternatives or len(peers)!=1 or len(alternatives)>8:
            raise exc
        candidate=r'^<HOST> - \S+ \[\s*\] "(?:'+'|'.join(dict.fromkeys(alternatives))+r') HTTP/\d(?:\.\d)?" [1-5]\d\d (?:\d+|-)(?: |$)'
        if len(candidate.encode())>1000 or candidate.count('<HOST>')!=1:
            raise exc
        normalized=[candidate]
        text='[Definition]\nfailregex = '+candidate.replace('%','%%')+'\nignoreregex =\n'
        validate_filter(text,evidence)
        fallback=True
    matched=[]
    with tempfile.TemporaryDirectory(prefix='amsfb-normalize-') as directory:
        path=Path(directory)/'normalized.conf';path.write_text(text)
        for line in evidence:
            if matches(path,[line]):matched.append(hashlib.sha256(line.encode()).hexdigest())
    return {'success':True,'patterns':normalized,'changed':patterns!=normalized,'matched_sha256':matched,'closed_sql_repair':fallback}


def extend_managed_rule(manifest):
    if int(os.environ.get('SUDO_UID', os.getuid())) != 0:
        raise ValueError('Managed extension requires root worker')
    jail, name = manifest['jail'], manifest['filter']
    if not JAIL.fullmatch(jail) or not jail.startswith('amsfb-') or not JAIL.fullmatch(name) or not name.startswith('amsfb-'):
        raise ValueError('Managed identity required')
    cfg = effective_config()
    if jail not in cfg or cfg[jail].get('filter', '').split('[', 1)[0] != name or cfg[jail].get('enabled','').lower() not in ('true','1','yes','on'):
        raise ValueError('Active matching managed jail required')
    state = loaded_filter_state(jail)
    if state['prefregex'] or state['ignoreregex'] or any('(?!)' in p for p in state['patterns']):
        raise ValueError('Quarantined or contextual filter cannot be extended')
    target = ROOT / 'filter.d' / (name + '.conf')
    if target.is_symlink() or not target.is_file():
        raise ValueError('Regular managed filter required')
    old = target.read_text()
    if hashlib.sha256(old.encode()).hexdigest() != manifest['sha256']:
        raise ValueError('Filter changed concurrently')
    patterns = manifest['patterns']
    if not isinstance(patterns, list) or not 1 <= len(patterns) <= 50 or any(not isinstance(p,str) or '\n' in p or '\r' in p for p in patterns):
        raise ValueError('Invalid bounded expressions')
    if not set(state['patterns']).issubset(patterns):
        raise ValueError('Extension cannot remove loaded expressions')
    disk = [p.strip().replace('%%','%') for p in parse(old).get('Definition','failregex').splitlines() if p.strip()]
    if set(disk) != set(state['patterns']):
        raise ValueError('Disk and loaded filter differ')
    sources = manifest['sources']
    if not isinstance(sources,list) or not 1 <= len(sources) <= 8 or any(p not in APPROVED_SOURCES or str(Path(p).resolve()) != p or not Path(p).is_file() for p in sources):
        raise ValueError('Only approved real log files are allowed')
    if not set(state['paths']).issubset(sources):
        raise ValueError('Extension cannot remove monitored files')
    formats = {'access' if 'access' in Path(p).name else 'error' if 'error' in Path(p).name else 'auth' for p in sources}
    if len(formats) != 1:
        raise ValueError('Incompatible log formats')
    text = '[Definition]\nfailregex = ' + '\n            '.join(p.replace('%','%%') for p in patterns) + '\nignoreregex =\n'
    validate_filter(text, manifest['evidence'])
    consumers = sorted(j for j,c in cfg.items() if c.get('filter','').split('[',1)[0] == name and c.get('enabled','').lower() in ('true','1','yes','on'))
    before = tickets(consumers, native=True)
    actions = {j:FIREWALL['action_specs'](j,run) for j in consumers}
    override = ROOT / 'jail.d' / 'zz-amsfb-managed-sources.local'
    previous = override.read_text() if override.exists() else None
    overrides = parse(previous or '')
    if not overrides.has_section(jail):overrides.add_section(jail)
    overrides.set(jail, 'logpath', '\n'.join(sources));overrides.set(jail, 'usedns', 'no')
    output=io.StringIO();overrides.write(output)
    try:
        atomic_write(target,text);atomic_write(override,output.getvalue())
        run(['/usr/bin/fail2ban-client','-t'])
        for consumer in consumers:run(['/usr/bin/fail2ban-client','reload',consumer])
        verify_preserved_tickets(before)
        for consumer in consumers:
            if FIREWALL['action_specs'](consumer,run) != actions[consumer]:raise ValueError('Actions changed during extension')
            current=tickets([consumer],native=True)
            coverage=FIREWALL['inspect'](consumer,[t['ip'] for t in current],run)
            if coverage['no_actions'] or coverage['unsupported_actions'] or coverage['missing_ips']:raise ValueError('Extended rule coverage unconfirmed')
        loaded=loaded_filter_state(jail)
        if set(loaded['paths']) != set(sources) or set(loaded['patterns']) != set(patterns):raise ValueError('Loaded rule differs')
    except BaseException:
        atomic_write(target,old)
        if previous is None:
            if override.exists():override.unlink()
        else:atomic_write(override,previous)
        for consumer in consumers:run(['/usr/bin/fail2ban-client','reload',consumer])
        raise
    return {'success':True,'jail':jail,'sources':sources,'tickets_checked':len(before)}


def source_peer(line):
    # Resolve the structured connection peer before looking inside messages.
    # Apache access URL/user-agent fields can contain forged [client ...] text.
    candidates = [r'^(\S+)\s+-\s+',
                  r'^\d{4}-\d\d-\d\d[ T]\d\d:\d\d:\d\d\s+WHMCS login failed from (\S+)\s+area=',
                  r'^(?:\d{4}-\d\d-\d\d[ T]\d\d:\d\d:\d\d\S*|[A-Za-z]{3}\s+\d{1,2}\s+\d\d:\d\d:\d\d)\s+(?:\S+\s+)?sshd(?:\[\d+\])?:.*\sfrom\s+(\S+)\s+port\s+\d+(?:\s|$)']
    for expression in candidates:
        found = re.search(expression, line)
        if found:
            try:
                return str(ipaddress.ip_address(found[1].strip('[]')))
            except ValueError:
                return None
    client = re.search(r'^(?:\[[^\]\r\n]*\]\s*)*?\[client ([^\]]+)\]', line)
    if client:
        value = client[1]
        choices = [value.rsplit(':', 1)[0], value] if re.search(r':\d+$', value) else [value]
        for choice in choices:
            try:
                return str(ipaddress.ip_address(choice.strip('[]')))
            except ValueError:
                pass
    return None


def replace_existing_filter(name, text, expected, evidence, quarantine=False):
    """Root operational repair; never restart a jail or recreate a ticket."""
    if int(os.environ.get('SUDO_UID', os.getuid())) != 0:
        raise ValueError('Existing native filter repair requires root CLI')
    if not FILTER.fullmatch(name) or not name.startswith('amsfb-'):
        raise ValueError('Invalid existing managed filter name')
    target = ROOT / 'filter.d' / (name + '.conf')
    if target.is_symlink() or not target.is_file():
        raise ValueError('Existing regular filter required')
    old = target.read_text()
    if hashlib.sha256(old.encode()).hexdigest() != expected:
        raise ValueError('Filter changed concurrently')
    if quarantine:
        text = '[Definition]\nfailregex = ^(?!)<HOST>$\nignoreregex =\n'
    else:
        validate_filter(text, evidence)
    consumers = sorted(j for j, cfg in effective_config().items()
                       if cfg.get('filter', '').split('[', 1)[0] == name
                       and cfg.get('enabled', '').lower() in ('true', '1', 'yes', 'on'))
    before = tickets(consumers, native=True)
    actions = {j: FIREWALL['action_specs'](j, run) for j in consumers}
    override = ROOT / 'jail.d' / '97-amsfb-detection.local'
    previous = override.read_text() if override.exists() else None
    cfg = parse(previous or '')
    for jail in consumers:
        if not cfg.has_section(jail):
            cfg.add_section(jail)
        cfg.set(jail, 'usedns', 'no')
    output = io.StringIO()
    cfg.write(output)
    try:
        atomic_write(target, text)
        atomic_write(override, output.getvalue())
        run(['/usr/bin/fail2ban-client', '-t'])
        for jail in consumers:
            run(['/usr/bin/fail2ban-client', 'reload', jail])
        current = {(t['jail'], t['ip']): t['ticket'] for t in tickets(consumers, native=True)}
        for ticket in before:
            key = (ticket['jail'], ticket['ip'])
            expires = time.mktime(time.strptime(ticket['ticket'].rsplit(' = ', 1)[-1], '%Y-%m-%d %H:%M:%S'))
            if key in current and current[key] != ticket['ticket']:
                raise ValueError('Filter repair altered ticket lifetime')
            if expires > time.time()+1 and key not in current:
                raise ValueError('Filter repair lost a valid ticket')
        for jail in consumers:
            if FIREWALL['action_specs'](jail, run) != actions[jail]:
                raise ValueError('Filter repair changed loaded actions')
            if native_command(['get', jail, 'usedns']) != 'no':
                raise ValueError('DNS override not effective')
            ips = [ip for (j, ip) in current if j == jail]
            state = FIREWALL['inspect'](jail, ips, run)
            if state['no_actions'] or state['unsupported_actions'] or state['missing_ips']:
                raise ValueError('Filter repair coverage unconfirmed')
    except Exception:
        atomic_write(target, old)
        if previous is not None:
            atomic_write(override, previous)
        elif override.exists():
            override.unlink()
        for jail in consumers:
            run(['/usr/bin/fail2ban-client', 'reload', jail])
        raise
    return {'success': True, 'consumers': consumers, 'quarantined': quarantine,
            'tickets_checked': len(before), 'sha256': hashlib.sha256(text.encode()).hexdigest()}


def atomic_write(dest, text, mode=0o644):
    BACKUPS.mkdir(mode=0o700, parents=True, exist_ok=True)
    if dest.exists():
        backup = BACKUPS / (dest.name + '.' + str(time.time_ns()) + '.bakp')
        shutil.copy2(dest, backup)
        os.chmod(backup, 0o600)
    fd, tmp = tempfile.mkstemp(prefix='.amsfb-', dir=dest.parent)
    try:
        with os.fdopen(fd, 'w') as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, dest)
        dfd = os.open(dest.parent, os.O_DIRECTORY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    finally:
        if os.path.exists(tmp):
