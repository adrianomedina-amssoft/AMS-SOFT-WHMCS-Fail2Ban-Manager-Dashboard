              for status in (200,403,404)
              for agent in ('Mozilla/5.0 (compatible)','curl/8.0','Googlebot')]
    # Error-log counterexamples are as important as ordinary access requests.
    for peer in ('198.51.100.10', '2001:db8::10'):
